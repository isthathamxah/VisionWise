# MongoDB Atlas — get from mongodb.com/atlas > Connect > Drivers
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/visionwise

# JWT — generate two random strings (use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth — from console.cloud.google.com > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Gemini — from aistudio.google.com > Get API key
GEMINI_API_KEY=

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
